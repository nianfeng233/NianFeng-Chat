{
  "name": "nianfeng-chat",
  "version": "2.2.0-preview.8",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "念风：本地优先、插件化的 AI 聊天客户端（cordis v4 内核 + Node 本地后端）",
  "scripts": {
    "start": "node start.mjs",
    "dev": "node start.mjs",
    "stop": "node scripts/stop.mjs",
    "serve": "node start.mjs --serve",
    "backend": "node server/index.mjs",
    "sync-plugins": "node scripts/sync-plugins.mjs",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "build:release": "node scripts/package-release.mjs",
    "build:desktop": "node scripts/package-release.mjs --desktop-only",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "check:style": "node scripts/check-style.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "release:gate": "npm run verify:production && npm test",
    "check:kernels": "node scripts/check-syntax.mjs && node scripts/check-style.mjs",
    "test:deps": "node scripts/test-dependencies.mjs",
    "test:hot-plugins": "node scripts/test-hot-plugins.mjs",
    "test:plugin-scan": "node scripts/test-plugin-scan.mjs",
    "test:static-cache": "node scripts/test-static-cache.mjs",
    "test:event-source": "node scripts/test-event-source-multiplex.mjs",
    "test:web-proxy": "node scripts/test-web-proxy.mjs",
    "test:webui-scope": "node scripts/test-webui-scope.mjs",
    "test:external-plugins": "node scripts/test-external-plugins.mjs",
    "test:agent-bridge": "node scripts/test-agent-bridge.mjs",
    "test:knowledge-reload": "node scripts/test-knowledge-reload.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:failover": "node scripts/test-failover.mjs",
    "test:chat": "node scripts/test-chat.mjs",
    "test:chat-tools": "node scripts/test-chat-tools.mjs",
    "test:memory": "node scripts/test-memory-same-session.mjs",
    "test:memory-policy": "node scripts/test-memory-policy.mjs",
    "test:vendors": "node scripts/test-vendors.mjs",
    "test:clawbot": "node scripts/test-clawbot.mjs",
    "test:qqbot": "node scripts/test-qqbot.mjs",
    "test:images": "node scripts/test-images.mjs",
    "mock:openai": "node scripts/mock-openai.mjs",
    "test": "npm run check:kernels && npm run test:deps && npm run test:hot-plugins && npm run test:plugin-scan && npm run test:static-cache && npm run test:event-source && npm run test:web-proxy && npm run test:webui-scope && npm run test:external-plugins && npm run test:agent-bridge && npm run test:knowledge-reload && npm run test:backend && npm run test:security && npm run test:failover && npm run test:memory-policy && npm run test:images && npm run test:clawbot && npm run test:qqbot && npm run test:napcat && npm run test:smoke && npm run test:chat && npm run test:chat-tools && npm run test:vendors",
    "test:napcat": "node scripts/test-napcat.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.10"
  }
}
